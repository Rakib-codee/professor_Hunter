# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Production/preview values live in the Vercel dashboard, not in the repo.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Used by /api/draft and scripts/import-csv.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# No custom domain yet; set to the Vercel URL in production. Keep everything domain-independent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=professorhunter.help@outlook.com

# --- LLM draft generation (server-only) ---
# mock | deepseek | groq. "mock" is for local dev and tests only and is never shown to real users;
# in production, leave LLM_PROVIDER unset or "none" until a real key exists (draft button shows "coming soon").
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
