# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Production/preview values live in the Vercel dashboard, not in the repo.

# --- Supabase ---
# Project Settings → Data API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → "Publishable key" (sb_publishable_...). Safe for the browser; RLS applies.
# (The legacy "anon" JWT also works here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Project Settings → API Keys → "Secret keys" (sb_secret_...). SERVER ONLY. Bypasses RLS.
# Used by /api/draft, admin stats and scripts/import-csv.ts. (Legacy "service_role" JWT also works.)
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Site ---
# No custom domain yet; set to the Vercel URL in production. Keep everything domain-independent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=professorhunter.help@outlook.com

# --- Cloudflare Turnstile (bot protection on login / signup / forgot-password) ---
# Optional. Leave empty to hide the widget (only valid while Supabase CAPTCHA protection is OFF).
# Cloudflare dashboard → Turnstile → your widget → "Site Key". The matching SECRET key is NOT
# stored here: paste it in Supabase → Authentication → Attack Protection → CAPTCHA (Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- LLM draft generation (server-only) ---
# mock | deepseek | groq. "mock" is for local dev and tests only and is never shown to real users;
# in production, leave LLM_PROVIDER unset or "none" until a real key exists (draft button shows "coming soon").
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
